library(here)
survey <- read.csv(here("GNSS Data", "20260528", "Positions file", "CCR_20260528_corrected.csv"))
View(survey)
# Check your column names — adjust these to match your file
head(survey)
# Convert to an sf object, telling it the data is currently in WGS84 lat/long (EPSG:4326)
pts <- st_as_sf(survey, coords = c("Longitude", "Latitude"), crs = 4326)
library(sf)
library(dplyr)
# Convert to an sf object, telling it the data is currently in WGS84 lat/long (EPSG:4326)
pts <- st_as_sf(survey, coords = c("Longitude", "Latitude"), crs = 4326)
# Read your CSV
survey <- read.csv(here("GNSS Data", "20260528", "Positions file", "CCR_20260528_corrected_cleaned.csv"))
# Check your column names — adjust these to match your file
head(survey)
# Convert to an sf object, telling it the data is currently in WGS84 lat/long (EPSG:4326)
pts <- st_as_sf(survey, coords = c("Longitude", "Latitude"), crs = 4326)
View(pts)
# Reproject to UTM Zone 17N (EPSG:32617)
pts_utm <- st_transform(pts, crs = 32617)
# Extract Easting/Northing as plain columns
coords <- st_coordinates(pts_utm)
survey$Easting  <- coords[, "X"]
survey$Northing <- coords[, "Y"]
View(survey)
View(survey)
View(survey)
# Allow PROJ to auto-download the GEOID18 grid the first time this runs (needs internet once)
Sys.setenv(PROJ_NETWORK = "ON")
# Read your CSV
survey <- read.csv(here("GNSS Data", "20260528", "Positions file", "CCR_20260528_corrected_cleaned.csv"))
# Build a 3D point object: WGS84 lon/lat/ellipsoidal height (EPSG:4979 = WGS84 3D geographic)
pts <- st_as_sf(survey, coords = c("Longitude", "Latitude", "Ellipsoidal.height"),
crs = 4979)
View(pts)
# Transform straight to NAD83(2011) UTM zone 17N (horizontal) + NAVD88 height (vertical)
# EPSG:6346 = NAD83(2011) / UTM zone 17N,  EPSG:5703 = NAVD88 height
pts_out <- st_transform(pts, "EPSG:6346+5703")
View(pts_out)
pts_out <- pts_out |>
select(Description, geometry)
coords <- st_coordinates(pts_out)
survey$Easting    <- coords[, "X"]
survey$Northing   <- coords[, "Y"]
survey$Elevation  <- coords[, "Z"]   # NAVD88 orthometric elevation
View(survey)
View(survey)
#clean df
survey <- survey |>
select(Description, Easting, Northing, Elevation)
View(survey)
View(survey)
# Read your CSV
survey <- read.csv(here("GNSS Data", "20260528", "Positions file", "CCR_20260528_corrected_cleaned.csv"))
View(survey)
source("~/Github/CCR_Geophysics/GNSS Data/ConvertCoords.R", echo = TRUE)
View(survey)
View(survey)
#interpolate for missing points
pt_seq <- seq(1:max(survey$Name), by = 1)
#interpolate for missing points
pt_seq <- 1:max(survey$Name)
#interpolate for missing points
Name <- 1:max(survey$Name)
survey <- left_join(pt_seq, survey, by = Name)
#interpolate for missing points
pt_seq <- data.frame (Name = 1:max(survey$Name))
survey <- left_join(pt_seq, survey, by = Name)
survey <- left_join(pt_seq, survey, by = "Name")
View(survey)
survey <- survey |>
arrange(by = 'Name')
View(survey)
library(zoo)
survey_full <- survey |>
mutate(
Easting   = na.approx(Easting, x = Name, na.rm = FALSE),
Northing  = na.approx(Northing, x = Name, na.rm = FALSE),
Elevation = na.approx(Elevation, x = Name, na.rm = FALSE)
)
View(survey_full)
ggplot() +
geom_point(data = survey, aes(x = Easting, y = Elevation))
library(ggplot2)
ggplot() +
geom_point(data = survey, aes(x = Easting, y = Elevation))
View(survey)
ggplot() +
geom_point(data = survey, aes(x = Easting, y = Elevation)) +
geom_point(data = survey_full, aes(x = Easting, y = Elevation), color = 'steelblue')
ggplot() +
geom_point(data = survey_full, aes(x = Easting, y = Elevation), color = 'steelblue') +
geom_point(data = survey, aes(x = Easting, y = Elevation))
write.csv(survey_full, "survey_data_utm17n_navd88.csv", row.names = FALSE)
